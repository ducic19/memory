class Main {
    
    function void pravila_igre(){
        var int nastavak;
        do Screen.clearScreen();

        do Output.moveCursor(6, 17);
        do Output.printString("Ploca s karticama je matrica.");
        do Output.moveCursor(8,15);
        do Output.printString("npr. gornja lijeva kartica je (1,1).");
        do Output.moveCursor(10,9);
        do Output.printString("Odaberite red i stupac kako biste otkrili znak");
        do Output.moveCursor(21,17);
        do Output.printString("Unesi ENTER za nastavak: ");

        let nastavak = 0;
        while (~(nastavak=128)){
            let nastavak=Keyboard.readChar();
        }
        do Screen.clearScreen();

        do Output.moveCursor(8,12);
        do Output.printString("U nastavku odaberite tezinu igre, te");
        do Output.moveCursor(10,20);
        do Output.printString("pocnite s igrom.");
        do Output.moveCursor(15,23);
        do Output.printString("Sretno!");
        do Output.moveCursor(21,17);
        do Output.printString("Unesi ENTER za nastavak: ");

        let nastavak = 0;

        while(~(nastavak = 128)){
            let nastavak = Keyboard.readChar();
        }

        do Screen.clearScreen();

        return;
    }

    function int odaberi_tezinu(int tezina_igre)
    {
        let tezina_igre=0; 
        while((tezina_igre<1)|(tezina_igre>3)){
            do Output.moveCursor(8,19);
            do Output.printString("Izaberi tezinu igre:");
            do Output.moveCursor(12, 22);
            do Output.printString("Lagano : 1");
            do Output.moveCursor(14, 22);
            do Output.printString("Srednje : 2");
            do Output.moveCursor(16, 22);
            do Output.printString("Tesko : 3");
            do Output.moveCursor(19, 22);
            let tezina_igre = Keyboard.readInt("Biram: ");

            if((tezina_igre<1)|(tezina_igre>3)){
                do Output.moveCursor(21,15);
                do Output.printString("KRIVI UNOS!");
            }
        }
        do Screen.clearScreen();
        
        return tezina_igre;
    }
    function Array dimenzije(int tezina){
        var Array dim;
        let dim= Array.new(2);

        if(tezina=1){
            let dim[0]=2;
            let dim[1]=3;
        }
        if(tezina=2){
            let dim[0]=3;
            let dim[1]=4;
        }
        if(tezina=3){
            let dim[0]=4;
            let dim[1]=4;
        }
        return dim;
    }
    function void main()
    {
        var Ploca tabla;
        var Spil spilOBJ;
        var Array dimenzije;
        var int tezina_igre,seed,x,y,brojkartica;
        var int i; 

        let i = 0; 
        while(i<64){
            do Output.moveCursor(0,i);
            do Output.printString("X");
            do Output.moveCursor(22,i);
            do Output.printString("X");
            let i=i+1;
        }
        let i=1;
        while(i<22){
            do Output.moveCursor(i,0);
            do Output.printString("X");
            do Output.moveCursor(i,63);
            do Output.printString("X");
            let i=i+1;
        }

        do Output.moveCursor(10, 24);
        do Output.printString("Memory game");  //ovo ljepse napravit nekako neki font opalit 
        do Output.moveCursor(20,21);
        do Output.printString("Pritisni neku tipku"); 

        let seed=0; 
        while(Keyboard.keyPressed()=0){
            let seed=seed+1;
            if(seed=32767){
                let seed=0;
            }
        }

        do Screen.clearScreen();

        do Main.pravila_igre();
        let tezina_igre = Main.odaberi_tezinu(0);
        if(~(tezina_igre = 1) | ~(tezina_igre = 2) | ~(tezina_igre = 3)){
            while(tezina_igre > 3){
                let tezina_igre = Main.odaberi_tezinu(0);
            }
        }

        let dimenzije=Main.dimenzije(tezina_igre);
        let x=dimenzije[0];
        let y=dimenzije[1];
        let brojkartica=x*y;

        let tabla=Ploca.tabla(x,y);
        let spilOBJ=Spil.new(brojkartica/2,seed);

        do tabla.postavi_kartice(brojkartica,spilOBJ);
        do tabla.nacrtaj_plocu(x,y);
        do tabla.play(x,y);

        do dimenzije.dispose();
        do spilOBJ.dispose();
        do tabla.destructor();

        return;
    }
}